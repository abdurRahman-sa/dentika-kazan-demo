---
import { clinic } from '../data/clinic';
---

<div
  data-mobile-bar
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-line bg-paper px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] transition-transform duration-300 md:hidden"
>
  <a href={clinic.phoneHref} class="btn min-h-12 border border-ink">Позвонить</a>
  <a href="#booking" class="btn btn-amber min-h-12">Записаться</a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-bar]');
  const booking = document.getElementById('booking');
  if (bar && booking && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => {
        bar.style.transform = entry.isIntersecting ? 'translateY(110%)' : '';
      },
      { threshold: 0.1 },
    ).observe(booking);
  }
</script>

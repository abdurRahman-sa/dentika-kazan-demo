---
const navItems = [
  { href: '#hero', label: 'Главная', active: true },
  { href: '#services', label: 'Услуги' },
  { href: '#doctors', label: 'Врачи' },
  { href: '#before-after', label: 'До/После' },
  { href: '#booking', label: 'Запись' },
  { href: '#contacts', label: 'Контакты' },
];
---

<aside class="flex-none w-[130px] py-8 px-3 sticky top-0 self-start h-screen overflow-y-auto max-[900px]:static max-[900px]:w-auto max-[900px]:h-auto max-[900px]:flex max-[900px]:flex-row max-[900px]:flex-wrap max-[900px]:items-center max-[900px]:gap-y-1.5 max-[900px]:px-4 max-[900px]:py-2.5 max-[900px]:bg-bg max-[900px]:border-b max-[900px]:border-hairline max-[900px]:z-10">
  <div class="flex items-center gap-2 mb-7 max-[900px]:mb-0 max-[900px]:mr-4 max-[900px]:whitespace-nowrap">
    <svg class="shrink-0" width="34" height="42" viewBox="-2 0 40 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g fill="var(--color-ink)">
        <g transform="translate(8,33) rotate(-32)">
          <path d="M0,-11 C6.5,-6.5 6.5,6.5 0,11 C-6.5,6.5 -6.5,-6.5 0,-11 Z" />
          <path d="M0,-9 L0,9 M0,-3 L-3.4,-1 M0,1 L-3.4,3 M0,-3 L3.4,-1 M0,1 L3.4,3" stroke="var(--color-bg)" stroke-width="0.6" fill="none" />
        </g>
        <g transform="translate(28,33) rotate(32)">
          <path d="M0,-11 C6.5,-6.5 6.5,6.5 0,11 C-6.5,6.5 -6.5,-6.5 0,-11 Z" />
          <path d="M0,-9 L0,9 M0,-3 L-3.4,-1 M0,1 L-3.4,3 M0,-3 L3.4,-1 M0,1 L3.4,3" stroke="var(--color-bg)" stroke-width="0.6" fill="none" />
        </g>
      </g>
      <path d="M18,17 L18,35" stroke="var(--color-ink)" stroke-width="1.4" stroke-linecap="round" />
      <g fill="var(--color-ink)" stroke="var(--color-bg)" stroke-width="0.6">
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(36 18 15)" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(72 18 15)" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(108 18 15)" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(144 18 15)" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(180 18 15)" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(216 18 15)" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(252 18 15)" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(288 18 15)" />
        <ellipse cx="18" cy="7" rx="4.6" ry="6.5" transform="rotate(324 18 15)" />
      </g>
      <g fill="var(--color-bg)">
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(18 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(54 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(90 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(126 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(162 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(198 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(234 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(270 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(306 18 15)" />
        <ellipse cx="18" cy="9.3" rx="2.4" ry="4.6" transform="rotate(342 18 15)" />
      </g>
      <circle cx="18" cy="15" r="2.6" fill="var(--color-bg)" />
    </svg>
    <span class="font-slab text-[17px] text-ink">Dentika</span>
  </div>
  <nav class="flex flex-col gap-1 max-[900px]:flex-row max-[900px]:flex-wrap max-[900px]:gap-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          'relative text-[13px] no-underline py-1.5 pl-3.5 pr-2 rounded-[2px] max-[900px]:px-2.5',
          "before:content-[''] before:absolute before:left-0 before:top-1/2 before:-translate-y-1/2 before:w-[3px] before:h-3.5 before:rounded-[1px]",
          item.active
            ? 'text-ink bg-white before:bg-teal'
            : 'text-slate-text before:bg-slate before:opacity-35',
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>
</aside>

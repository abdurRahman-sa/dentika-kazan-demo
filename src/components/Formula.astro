---
type Kind = 'i' | 'c' | 'p' | 'm';

interface Tooth {
  n: number;
  kind: Kind;
  i: number;
}

const kindOf = (pos: number, primary: boolean): Kind =>
  pos <= 2 ? 'i' : pos === 3 ? 'c' : primary || pos >= 6 ? 'm' : 'p';

const quadrant = (q: number, primary: boolean, fromOuter: boolean): Tooth[] => {
  const count = primary ? 5 : 8;
  const teeth = Array.from({ length: count }, (_, k) => ({ n: q * 10 + k + 1, kind: kindOf(k + 1, primary), i: k }));
  return fromOuter ? teeth.reverse() : teeth;
};

// Нумерация FDI: четверти 1–4 у постоянных зубов, 5–8 у молочных; вид со стороны врача
const sets = [
  {
    id: 'permanent',
    rows: [
      [quadrant(1, false, true), quadrant(2, false, false)],
      [quadrant(4, false, true), quadrant(3, false, false)],
    ],
    caption: 'Постоянных зубов 32. Первая цифра номера — четверть челюсти (1–4), вторая — место зуба от центра.',
  },
  {
    id: 'primary',
    rows: [
      [quadrant(5, true, true), quadrant(6, true, false)],
      [quadrant(8, true, true), quadrant(7, true, false)],
    ],
    caption: 'Молочных зубов 20. Их четверти обозначают цифрами 5–8, а зубы — от 1 до 5.',
  },
];

const grow: Record<Kind, number> = { i: 0.8, c: 0.9, p: 1, m: 1.3 };
---

<div data-formula data-reveal="teeth" class="w-full">
  <div class="mb-3 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.12em] text-ink-soft sm:text-[11px]">
    <span>Правая сторона</span>
    <span class="hidden sm:inline">Верхняя челюсть</span>
    <span>Левая сторона</span>
  </div>

  {sets.map((set) => (
    <div data-set={set.id} hidden={set.id !== 'permanent'}>
      <div aria-hidden="true">
        {set.rows.map((row, r) => (
          <div class:list={['flex', r === 0 ? 'items-end' : 'mt-1.5 items-start']}>
            {row.map((half, h) => (
              <Fragment>
                {h === 1 && <span class="mx-1 w-0.5 self-stretch rounded bg-ink sm:mx-2" />}
                <div class:list={['flex flex-1 gap-[3px] sm:gap-1', r === 0 ? 'items-end' : 'items-start']}>
                  {half.map((t) => (
                    <span
                      class:list={['tooth', r === 0 ? 'tooth-upper' : 'tooth-lower']}
                      data-kind={t.kind}
                      style={`flex-grow:${grow[t.kind]};--i:${t.i}`}
                    >
                      {t.n}
                    </span>
                  ))}
                </div>
              </Fragment>
            ))}
          </div>
        ))}
      </div>
      <div class="mt-3 flex items-start justify-between gap-6">
        <p class="max-w-[54ch] text-sm text-ink-soft">
          {set.caption} Схема — как её видит врач: правая сторона пациента слева.
        </p>
        <span class="hidden shrink-0 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-soft sm:inline">Нижняя челюсть</span>
      </div>
    </div>
  ))}
</div>

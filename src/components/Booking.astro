---
import SectionLabel from './SectionLabel.astro';
import { clinic, services } from '../data/clinic';

const patients = [
  { value: 'adult', label: 'Взрослого' },
  { value: 'child', label: 'Ребёнка' },
];
const times = ['Утром', 'Днём', 'Вечером'];
---

<section id="booking" class="on-dark bg-pine px-gutter py-section text-white">
  <div class="grid gap-x-gutter gap-y-12 lg:grid-cols-12">
    <div class="flex flex-col lg:col-span-5">
      <SectionLabel code="15" label="Запись" tone="light" />
      <h2 class="mt-5 max-w-[12ch] text-title font-bold tracking-[-0.025em]">Запись на приём</h2>
      <p class="mt-5 max-w-[42ch] text-[17px] leading-relaxed text-white/80">
        Оставьте заявку или позвоните в клинику. Если записываете ребёнка — отметьте это в форме.
      </p>
      <a href={clinic.phoneHref} class="mt-8 self-start font-mono text-[clamp(1.6rem,3vw,2.5rem)] font-semibold text-amber hover:underline">
        {clinic.phoneDisplay}
      </a>
      <p class="mt-2 text-white/70">{clinic.district}, {clinic.address}</p>
      <p class="mt-10 max-w-[44ch] border-l-2 border-amber pl-4 text-sm text-white/75 lg:mt-auto">
        Демо-версия: форма работает без сервера — введённые данные никуда не отправляются.
      </p>
    </div>

    <div class="lg:col-span-7">
      <form data-booking class="rounded-ui bg-paper p-5 text-ink sm:p-8 lg:p-10">
        <fieldset>
          <legend class="field-label">Кого записываем</legend>
          <div class="mt-3 grid grid-cols-2 gap-2">
            {patients.map((p, i) => (
              <label class="choice">
                <input type="radio" name="patient" value={p.value} checked={i === 0} class="sr-only" />
                {p.label}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-7">
          <label for="bk-service" class="field-label">Направление</label>
          <select id="bk-service" name="service" class="field mt-3">
            <option value="consult">Нужна консультация — не знаю направление</option>
            {services.map((s) => <option value={s.id}>{s.title}</option>)}
          </select>
        </div>

        <fieldset class="mt-7">
          <legend class="field-label">Удобное время</legend>
          <div class="mt-3 grid grid-cols-3 gap-2">
            {times.map((t, i) => (
              <label class="choice">
                <input type="radio" name="time" value={t} checked={i === 0} class="sr-only" />
                {t}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-7 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="bk-name" class="field-label">Имя</label>
            <input id="bk-name" name="name" required autocomplete="name" class="field mt-3" />
          </div>
          <div>
            <label for="bk-phone" class="field-label">Телефон</label>
            <input
              id="bk-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              required
              autocomplete="tel"
              placeholder="+7 900 000-00-00"
              pattern="[+0-9\s()\-]{10,20}"
              title="Номер телефона, например +7 900 000-00-00"
              class="field mt-3 font-mono"
            />
          </div>
        </div>

        <label class="mt-6 flex items-start gap-3 text-sm text-ink-soft">
          <input type="checkbox" name="consent" required class="mt-0.5 size-5 shrink-0 accent-pine" />
          <span>Даю согласие на обработку персональных данных. Политика конфиденциальности в демо-версии не подключена.</span>
        </label>

        <button type="submit" class="btn btn-amber mt-8 w-full sm:w-auto">
          Отправить заявку
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </form>

      <div data-booking-done hidden role="status" tabindex="-1" class="rounded-ui bg-paper p-6 text-ink sm:p-10">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">Демо-режим</p>
        <p class="mt-4 text-3xl font-bold tracking-[-0.02em]">Заявка заполнена</p>
        <p class="mt-3 max-w-[48ch] text-ink-soft">
          Данные не отправлены: это демонстрационная форма без сервера. В рабочей версии заявка поступит в клинику.
        </p>
        <button type="button" data-booking-reset class="btn mt-8 border border-ink hover:bg-ink hover:text-paper">Заполнить заново</button>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-booking]')!;
  const done = document.querySelector<HTMLElement>('[data-booking-done]')!;
  const select = form.querySelector<HTMLSelectElement>('select[name="service"]')!;

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    form.hidden = true;
    done.hidden = false;
    done.focus();
  });

  done.querySelector('[data-booking-reset]')!.addEventListener('click', () => {
    form.reset();
    done.hidden = true;
    form.hidden = false;
  });

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLElement>('[data-book]');
    if (!link) return;
    select.value = link.dataset.book!;
    const aud = document.documentElement.dataset.aud === 'child' ? 'child' : 'adult';
    const patient = form.querySelector<HTMLInputElement>(`input[name="patient"][value="${aud}"]`);
    if (patient) patient.checked = true;
  });
</script>

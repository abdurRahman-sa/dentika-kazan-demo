---
import { Image } from 'astro:assets';
import desk from '../assets/photos/reception-desk.png';
import cabinet from '../assets/photos/kabinet-4.png';
import hall from '../assets/photos/kabinet-4-hall.png';
import SectionLabel from './SectionLabel.astro';
import { clinic } from '../data/clinic';
---

<section id="clinic" class="py-section">
  <div class="grid gap-x-gutter gap-y-6 px-gutter lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-6">
      <SectionLabel code="13" label="Клиника" />
      <h2 class="mt-5 text-title font-bold tracking-[-0.025em]">Как выглядит клиника</h2>
    </div>
    <p class="max-w-[48ch] text-ink-soft lg:col-span-4 lg:col-start-9">
      Фотографии из клиники Дентика: ресепшен, коридор у кабинетов и лечебный кабинет.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-2 gap-2 px-gutter sm:gap-3 lg:h-[min(80svh,780px)] lg:grid-cols-12" data-reveal>
    <figure class="relative col-span-2 aspect-[4/5] overflow-hidden rounded-ui sm:aspect-[16/11] lg:col-span-5 lg:aspect-auto">
      <Image
        src={desk}
        alt="Ресепшен клиники и зона ожидания"
        widths={[480, 720, 880]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <figcaption class="photo-cap">Ресепшен</figcaption>
    </figure>

    <figure class="relative aspect-[3/4] overflow-hidden rounded-ui lg:col-span-4 lg:aspect-auto">
      <Image
        src={cabinet}
        alt="Лечебный кабинет: стоматологическое кресло и оборудование"
        widths={[400, 700, 996]}
        sizes="(min-width: 1024px) 33vw, 50vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <figcaption class="photo-cap">Лечебный кабинет</figcaption>
    </figure>

    <div class="contents lg:col-span-3 lg:grid lg:grid-rows-[minmax(0,1fr)_auto] lg:gap-3">
      <figure class="relative aspect-[3/4] overflow-hidden rounded-ui lg:aspect-auto">
        <Image
          src={hall}
          alt="Коридор у кабинета с креслами для ожидания"
          widths={[400, 756]}
          sizes="(min-width: 1024px) 25vw, 50vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <figcaption class="photo-cap">Коридор у кабинетов</figcaption>
      </figure>

      <div class="on-dark col-span-2 flex flex-col justify-between gap-6 rounded-ui bg-pine p-6 text-white sm:flex-row sm:items-end lg:col-span-1 lg:flex-col lg:items-start">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-mint">Где находится</p>
          <p class="mt-3 text-lg font-semibold leading-snug">{clinic.district}</p>
          <p class="mt-1 text-white/75">{clinic.address}</p>
        </div>
        <a href="#contacts" class="inline-flex items-center gap-2 font-semibold underline decoration-amber decoration-2 underline-offset-[6px]">
          Как добраться
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

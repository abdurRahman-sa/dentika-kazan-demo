---
import { Image } from 'astro:assets';
import roomPhoto from '../assets/clinic/kabinet-4.png';
import receptionPhoto from '../assets/clinic/reception-desk.png';
import waitingPhoto from '../assets/clinic/reception-logo.png';
---

<section id="clinic" class="clinic">
  <div class="wrap grid">
    <div class="title">
      <h2 class="h2">Клиника</h2>
      <p>Кабинеты, ресепшен и зона ожидания.</p>
    </div>
    <div class="ph photo photo-room">
      <Image src={roomPhoto} alt="Кабинет клиники Dentika: стоматологическое кресло и оборудование" />
    </div>
    <div class="ph photo photo-reception">
      <Image src={receptionPhoto} alt="Ресепшен клиники Dentika" />
    </div>
    <div class="ph photo photo-waiting">
      <Image src={waitingPhoto} alt="Зона ожидания клиники Dentika с вывеской на стене" />
    </div>
  </div>
</section>

<style>
  .clinic { padding: var(--sec-y) 0; background: var(--color-flat); }

  /* Реальные фото портретные (телефонные снимки 0.74–0.81), поэтому на десктопе они стоят
     рядом тремя высокими плитками: в кадре остаётся почти вся высота снимка.
     Кабинет чуть шире остальных как главный кадр; высота у всех плиток общая. */
  .grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 16px;
  }
  .title { grid-column: 1 / -1; margin-bottom: 16px; }
  .title p { margin-top: 10px; color: var(--color-ink-2); }

  /* Фото заполняют плитку целиком; рамка и скругление берутся у .ph */
  .photo { padding: 0; }
  .photo-reception, .photo-waiting { aspect-ratio: 4 / 5; }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-room :global(img) { object-position: 50% 40%; }
  /* Справа на исходнике обрывок вывески «DE…» упирается в край самого кадра камеры: плитка
     показывает всю ширину фото, поэтому убрать его обрезкой нельзя. Кандидат на точечную
     правку в Kling (убрать фрагмент, не дорисовывая текст) либо принять как есть. */
  .photo-reception :global(img) { object-position: 50% 55%; }
  .photo-waiting :global(img) { object-position: 50% 46%; }

  /* Телефон: кабинет во всю ширину, заголовок карточкой поверх него, ниже два квадрата */
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .photo-room { grid-column: 1 / -1; grid-row: 1; aspect-ratio: 4 / 3.6; }
    .title {
      grid-column: 1 / -1;
      grid-row: 1;
      align-self: start;
      z-index: 1;
      margin: 14px;
      padding: 18px 20px;
      border-radius: calc(24px * var(--round-k));
      background: rgba(255, 255, 255, .84);
      box-shadow: 0 20px 44px rgb(27 44 52 / calc(.14 * var(--shadow-k)));
    }
    .photo-reception, .photo-waiting { aspect-ratio: 1; }
  }
</style>

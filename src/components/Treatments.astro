---
import { treatments } from '../data/clinic';

// Зубной ряд строится при сборке: постоянные зубы по внешнему эллипсу, молочные по внутреннему.
type Tooth = { x: number; y: number; w: number; h: number; rot: number };

const CX = 600;
const CY = 320;

function arch(rx: number, ry: number, sizes: number[], top: boolean, share: number): Tooth[] {
  const total = sizes.reduce((sum, w) => sum + w, 0);
  const span = Math.PI - 0.24;
  const k = (share * Math.PI * Math.sqrt((rx * rx + ry * ry) / 2)) / total;
  let acc = 0;
  return sizes.map((w0) => {
    const t = (acc + w0 / 2) / total;
    acc += w0;
    const a = top ? Math.PI + 0.12 + t * span : Math.PI - 0.12 - t * span;
    const w = w0 * k;
    return {
      x: CX + Math.cos(a) * rx,
      y: CY + Math.sin(a) * ry,
      w,
      h: w * 0.8,
      rot: (Math.atan2(Math.cos(a) * ry, -Math.sin(a) * rx) * 180) / Math.PI,
    };
  });
}

// Моляры, премоляры, клык, резцы и зеркально
const half = [38, 42, 44, 32, 32, 30, 26, 30];
const perm = [...half, ...[...half].reverse()];
const milkHalf = [30, 28, 22, 18, 20];
const milk = [...milkHalf, ...[...milkHalf].reverse()];

const teeth = {
  u: arch(200, 250, perm, true, 0.72),
  l: arch(200, 250, perm, false, 0.72),
  mu: arch(120, 150, milk, true, 0.64),
  ml: arch(120, 150, milk, false, 0.64),
};

const f = (n: number) => n.toFixed(1);
const rect = (t: Tooth, cls = '') =>
  `<rect${cls ? ` class="${cls}"` : ''} x="${f(t.x - t.w / 2)}" y="${f(t.y - t.h / 2)}" width="${f(t.w)}" height="${f(t.h)}" rx="${f(t.h * 0.45)}" transform="rotate(${f(t.rot)} ${f(t.x)} ${f(t.y)})"/>`;

const implant = treatments.find((item) => item.ring);
const archSvg =
  `<g class="milk">${[...teeth.mu, ...teeth.ml].map((t) => rect(t)).join('')}</g>` +
  `<g class="perm">${teeth.u.map((t) => rect(t)).join('')}${teeth.l
    .map((t, i) => rect(t, implant && implant.tooth[0] === 'l' && implant.tooth[1] === i ? 'hl' : ''))
    .join('')}</g>`;

const leaders = treatments
  .map((item) => {
    const t = teeth[item.tooth[0]][item.tooth[1]];
    const x1 = item.side === 'l' ? 232 : 968;
    const ring = item.ring ? `<circle class="hl-ring" cx="${f(t.x)}" cy="${f(t.y)}" r="30"/>` : '';
    return `<g class="aud aud-${item.aud}"><path class="lead-line" d="M${x1} ${item.y} L${f(t.x)} ${f(t.y)}"/><circle class="lead-dot" cx="${f(t.x)}" cy="${f(t.y)}" r="4"/>${ring}</g>`;
  })
  .join('');

// На телефоне выноски не помещаются: зубы получают номера, а карточки под схемой те же номера
const numbered = treatments.map((item) => ({
  ...item,
  num: treatments.filter((other) => other.aud === item.aud).indexOf(item) + 1,
}));
const mobileMarkers = numbered
  .map((item) => {
    const t = teeth[item.tooth[0]][item.tooth[1]];
    return `<g class="aud aud-${item.aud} marker"><circle cx="${f(t.x)}" cy="${f(t.y)}" r="17"/><text x="${f(t.x)}" y="${f(t.y + 6)}" text-anchor="middle">${item.num}</text></g>`;
  })
  .join('');
---

<section id="treat" class="treat field" data-treat data-aud="adult">
  <div class="wrap head">
    <h2 class="h2">Что лечим</h2>
    <div class="toggle" role="group" aria-label="Для кого">
      <button type="button" data-set="adult" aria-pressed="true">Взрослым</button>
      <button type="button" data-set="child" aria-pressed="false">Детям</button>
    </div>
  </div>

  <div class="scheme">
    <svg viewBox="0 0 1200 640" role="img" aria-label="Схема зубного ряда: постоянные и молочные зубы" set:html={archSvg + leaders} />
    {treatments.map((item) => (
      <p class={`t-chip aud aud-${item.aud} side-${item.side}`} style={`top:${((item.y / 640) * 100).toFixed(2)}%`}>
        <b>{item.title}</b>{item.note}
      </p>
    ))}
  </div>

  <div class="scheme-mobile">
    <svg viewBox="372 48 456 544" role="img" aria-label="Схема зубного ряда с номерами направлений" set:html={archSvg + mobileMarkers} />
    <ol class="t-list">
      {numbered.map((item) => (
        <li class={`aud aud-${item.aud}`}>
          <span class="num" aria-hidden="true">{item.num}</span>
          <span><b>{item.title}</b>{item.note}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .treat { padding: var(--sec-y) 0; }
  .treat .head { display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; }

  .treat .toggle {
    display: inline-flex;
    padding: 6px;
    border-radius: 14px;
    background: rgba(255, 255, 255, .75);
    box-shadow: 0 8px 20px rgba(27, 44, 52, .08);
  }
  .treat .toggle button {
    padding: 10px 22px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-ink-2);
    cursor: pointer;
    transition: background-color .25s ease, color .25s ease;
  }
  .treat .toggle button:hover { color: var(--color-ink); }
  .treat .toggle button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-mist); }

  .treat .scheme {
    position: relative;
    width: min(1200px, calc(100% - 2 * var(--pad-x)));
    aspect-ratio: 1200 / 640;
    margin: 8px auto 0;
  }
  .treat .scheme svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .treat .perm rect { fill: #FFFFFF; stroke: var(--color-ink); stroke-width: 2; transition: fill .35s ease; }
  .treat .perm { transition: opacity .35s ease; }
  .treat .milk rect { fill: var(--color-flat); stroke: var(--color-milk); stroke-width: 1.4; transition: stroke .35s ease, fill .35s ease; }
  .treat .perm rect.hl { fill: var(--color-light-b); }
  .treat[data-aud='child'] .perm { opacity: .28; }
  .treat[data-aud='child'] .perm rect.hl { fill: #FFFFFF; }
  .treat[data-aud='child'] .milk rect { fill: #FFFFFF; stroke: var(--color-ink); stroke-width: 1.8; }

  .treat .lead-line { fill: none; stroke: var(--color-ink-2); stroke-opacity: .45; stroke-width: 1.5; }
  .treat .lead-dot { fill: var(--color-ink); }
  .treat .hl-ring { fill: none; stroke: var(--color-light); stroke-width: 2.5; }

  .treat .marker circle { fill: var(--color-ink); stroke: var(--color-light-b); stroke-width: 3; }
  .treat .marker text { fill: var(--color-mist); font-family: var(--font-display); font-weight: 600; font-size: 18px; }

  .treat .aud { transition: opacity .35s ease, visibility .35s; }
  .treat[data-aud='adult'] .aud-child,
  .treat[data-aud='child'] .aud-adult { opacity: 0; visibility: hidden; }

  .treat .t-chip {
    position: absolute;
    width: 18.5%;
    margin: 0;
    padding: 14px 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, .78);
    box-shadow: 0 10px 24px rgba(27, 44, 52, .10);
    font-size: 14px;
    line-height: 1.35;
    color: var(--color-ink-2);
    transform: translateY(-50%);
  }
  .treat .t-chip b, .treat .t-list b {
    display: block;
    margin-bottom: 2px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-ink);
  }
  /* На телефоне карточки узкие: заголовок меньше, текст может сжиматься и переноситься */
  .treat .t-list b { font-size: 15px; }
  .treat .t-list li > span:last-child { min-width: 0; overflow-wrap: break-word; hyphens: auto; }
  .treat .side-l { left: 0; }
  .treat .side-r { right: 0; }

  .treat .scheme-mobile { display: none; }

  @media (max-width: 900px) {
    .treat .scheme { display: none; }
    .treat .scheme-mobile { display: block; padding: 20px var(--pad-x) 0; }
    .treat .scheme-mobile svg { display: block; width: min(320px, 78%); height: auto; margin: 0 auto; overflow: visible; }
    .treat .t-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 24px 0 0;
      padding: 0;
      list-style: none;
    }
    .treat .t-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 14px 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, .78);
      font-size: 14px;
      line-height: 1.35;
      color: var(--color-ink-2);
    }
    .treat .t-list .num {
      flex: none;
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      margin-top: 1px;
      border-radius: 50%;
      background: var(--color-ink);
      box-shadow: 0 0 0 2px var(--color-light-b);
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 13px;
      color: var(--color-mist);
    }
    .treat[data-aud='adult'] .t-list .aud-child,
    .treat[data-aud='child'] .t-list .aud-adult { display: none; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-treat]');
  section?.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((button) => {
    button.addEventListener('click', () => {
      const aud = button.dataset.set ?? 'adult';
      section.dataset.aud = aud;
      section.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.set === aud));
      });
    });
  });
</script>

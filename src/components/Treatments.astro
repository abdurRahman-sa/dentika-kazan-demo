---
import { direction, treatments } from '../data/clinic';

// Зубной ряд строится при сборке: постоянные зубы по внешнему эллипсу, молочные по внутреннему.
type Tooth = { x: number; y: number; w: number; h: number; rot: number };

const CX = 600;
const CY = 320;

function arch(rx: number, ry: number, sizes: number[], top: boolean, share: number): Tooth[] {
  const total = sizes.reduce((sum, w) => sum + w, 0);
  const span = Math.PI - 0.24;
  const k = (share * Math.PI * Math.sqrt((rx * rx + ry * ry) / 2)) / total;
  let acc = 0;
  return sizes.map((w0) => {
    const t = (acc + w0 / 2) / total;
    acc += w0;
    const a = top ? Math.PI + 0.12 + t * span : Math.PI - 0.12 - t * span;
    const w = w0 * k;
    return {
      x: CX + Math.cos(a) * rx,
      y: CY + Math.sin(a) * ry,
      w,
      h: w * 0.8,
      rot: (Math.atan2(Math.cos(a) * ry, -Math.sin(a) * rx) * 180) / Math.PI,
    };
  });
}

// Моляры, премоляры, клык, резцы и зеркально
const half = [38, 42, 44, 32, 32, 30, 26, 30];
const perm = [...half, ...[...half].reverse()];
const milkHalf = [30, 28, 22, 18, 20];
const milk = [...milkHalf, ...[...milkHalf].reverse()];

const teeth = {
  u: arch(200, 250, perm, true, 0.72),
  l: arch(200, 250, perm, false, 0.72),
  mu: arch(120, 150, milk, true, 0.64),
  ml: arch(120, 150, milk, false, 0.64),
};

const f = (n: number) => n.toFixed(1);
const rect = (t: Tooth, cls = '') =>
  `<rect${cls ? ` class="${cls}"` : ''} x="${f(t.x - t.w / 2)}" y="${f(t.y - t.h / 2)}" width="${f(t.w)}" height="${f(t.h)}" rx="${f(t.h * 0.45)}" transform="rotate(${f(t.rot)} ${f(t.x)} ${f(t.y)})"/>`;

// Любой зуб ведёт к записи; зуб с выноской ещё и выбирает своё направление
const implant = treatments.find((item) => item.ring);
const archSvg =
  `<g class="milk" data-book="">${[...teeth.mu, ...teeth.ml].map((t) => rect(t)).join('')}</g>` +
  `<g class="perm" data-book="">${teeth.u.map((t) => rect(t)).join('')}${teeth.l
    .map((t, i) => rect(t, implant && implant.tooth[0] === 'l' && implant.tooth[1] === i ? 'hl' : ''))
    .join('')}</g>`;

// Плашка занимает 19.5% ширины схемы (234 из 1200), выноска начинается в 10 единицах от её края
const leaders = treatments
  .map((item) => {
    const t = teeth[item.tooth[0]][item.tooth[1]];
    const x1 = item.side === 'l' ? 244 : 956;
    const ring = item.ring ? `<circle class="hl-ring" cx="${f(t.x)}" cy="${f(t.y)}" r="30"/>` : '';
    return `<g class="aud aud-${item.aud} lead" data-book="${item.dir}"><path class="lead-line" d="M${x1} ${item.y} L${f(t.x)} ${f(t.y)}"/><circle class="lead-dot" cx="${f(t.x)}" cy="${f(t.y)}" r="4"/>${ring}<circle class="hit" cx="${f(t.x)}" cy="${f(t.y)}" r="34"/></g>`;
  })
  .join('');

// На телефоне выноски не помещаются: зубы получают номера, а карточки под схемой те же номера.
// Аудитория точки на схеме важнее списка аудиторий направления, поэтому item идёт вторым
const numbered = treatments.map((item) => ({
  ...direction(item.dir),
  ...item,
  num: treatments.filter((other) => other.aud === item.aud).indexOf(item) + 1,
}));
const mobileMarkers = numbered
  .map((item) => {
    const t = teeth[item.tooth[0]][item.tooth[1]];
    return `<g class="aud aud-${item.aud} marker" data-book="${item.dir}"><circle cx="${f(t.x)}" cy="${f(t.y)}" r="17"/><text x="${f(t.x)}" y="${f(t.y + 6)}" text-anchor="middle">${item.num}</text><circle class="hit" cx="${f(t.x)}" cy="${f(t.y)}" r="30"/></g>`;
  })
  .join('');
---

<section id="treat" class="treat field" data-treat data-aud="adult">
  <div class="wrap head">
    <h2 class="h2">Что лечим</h2>
    <div class="toggle" role="group" aria-label="Для кого">
      <button type="button" data-set="adult" aria-pressed="true">Взрослым</button>
      <button type="button" data-set="child" aria-pressed="false">Детям</button>
    </div>
  </div>

  <div class="scheme">
    <svg viewBox="0 0 1200 640" role="img" aria-label="Схема зубного ряда: постоянные и молочные зубы" set:html={archSvg + leaders} />
    {numbered.map((item) => (
      <a
        class={`t-chip aud aud-${item.aud} side-${item.side}`}
        style={`top:${((item.y / 640) * 100).toFixed(2)}%`}
        href="#booking"
        data-book={item.dir}
        aria-label={`${item.label}, ${item.note}: записаться`}
      >
        <b>{item.label}</b>{item.note}
      </a>
    ))}
  </div>

  <div class="scheme-mobile">
    <svg viewBox="372 48 456 544" role="img" aria-label="Схема зубного ряда с номерами направлений" set:html={archSvg + mobileMarkers} />
    <ol class="t-list">
      {numbered.map((item) => (
        <li class={`aud aud-${item.aud}`}>
          <a href="#booking" data-book={item.dir} aria-label={`${item.label}, ${item.note}: записаться`}>
            <span class="num" aria-hidden="true">{item.num}</span>
            <b>{item.label}</b>
            <span>{item.note}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .treat { padding: var(--sec-y) 0; }
  /* Сдвиги через отступы, а не transform: схема ниже смещается вместе с блоком и не перекрывается */
  .treat .head { display: flex; flex-direction: column; align-items: center; gap: 20px; margin-top: calc(var(--treat-title-y) * 1px); text-align: center; }

  .treat .toggle {
    display: inline-flex;
    margin-top: calc(var(--treat-toggle-y) * 1px);
    padding: 6px;
    border-radius: calc(14px * var(--round-k));
    background: rgba(255, 255, 255, .75);
    box-shadow: 0 8px 20px rgb(27 44 52 / calc(.08 * var(--shadow-k)));
  }
  .treat .toggle button {
    padding: 10px 22px;
    border: 0;
    border-radius: calc(10px * var(--round-k));
    background: transparent;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-ink-2);
    cursor: pointer;
    transition:
      background-color calc(.25s * var(--dur)) var(--ease-ui),
      color calc(.25s * var(--dur)) var(--ease-ui);
  }
  .treat .toggle button:hover { color: var(--color-ink); }
  .treat .toggle button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-mist); }

  .treat .scheme {
    position: relative;
    width: min(1200px, calc(100% - 2 * var(--pad-x)));
    aspect-ratio: 1200 / 640;
    margin: 8px auto 0;
  }
  /* Только сама схема, не иконки внутри плашек */
  .treat .scheme > svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .treat .perm rect { fill: #FFFFFF; stroke: var(--color-ink); stroke-width: 2; transition: fill calc(.35s * var(--dur)) var(--ease-ui); }
  .treat .perm { transition: opacity calc(.35s * var(--dur)) var(--ease-ui); }
  .treat .milk rect {
    fill: var(--color-flat);
    stroke: var(--color-milk);
    stroke-width: 1.4;
    transition: stroke calc(.35s * var(--dur)) var(--ease-ui), fill calc(.35s * var(--dur)) var(--ease-ui);
  }
  .treat .perm rect.hl { fill: var(--color-light-b); }
  .treat[data-aud='child'] .perm { opacity: .28; }
  .treat[data-aud='child'] .perm rect.hl { fill: #FFFFFF; }
  .treat[data-aud='child'] .milk rect { fill: #FFFFFF; stroke: var(--color-ink); stroke-width: 1.8; }

  /* Схема кликабельна: зуб под курсором ловит холодный свет, как выбранное в записи */
  .treat svg [data-book] { cursor: pointer; }
  .treat[data-aud='adult'] .perm rect:hover,
  .treat[data-aud='child'] .milk rect:hover { fill: var(--color-light-b); }
  .treat .hit { fill: transparent; }

  .treat .lead-line { fill: none; stroke: var(--color-ink-2); stroke-opacity: .45; stroke-width: 1.5; transition: stroke-opacity calc(.2s * var(--dur)) var(--ease-ui); }
  .treat .lead:hover .lead-line { stroke-opacity: .9; }
  .treat .lead-dot { fill: var(--color-ink); }
  .treat .hl-ring { fill: none; stroke: var(--color-light); stroke-width: 2.5; }

  .treat .marker circle:not(.hit) { fill: var(--color-ink); stroke: var(--color-light-b); stroke-width: 3; }
  .treat .marker text { fill: var(--color-mist); font-family: var(--font-display); font-weight: var(--display-weight); font-size: 18px; }

  .treat .aud { transition: opacity calc(.35s * var(--dur)) var(--ease-ui), visibility calc(.35s * var(--dur)); }
  .treat[data-aud='adult'] .aud-child,
  .treat[data-aud='child'] .aud-adult { opacity: 0; visibility: hidden; }

  .treat .t-chip {
    position: absolute;
    display: block;
    width: 19.5%;
    margin: 0;
    padding: 14px 18px;
    border-radius: calc(16px * var(--round-k));
    background: rgba(255, 255, 255, .78);
    box-shadow: 0 10px 24px rgb(27 44 52 / calc(.10 * var(--shadow-k)));
    font-size: 14px;
    line-height: 1.35;
    color: var(--color-ink-2);
    text-decoration: none;
    transform: translateY(-50%);
    transition:
      opacity calc(.35s * var(--dur)) var(--ease-ui),
      visibility calc(.35s * var(--dur)),
      background-color calc(.2s * var(--dur)) var(--ease-ui),
      box-shadow calc(.2s * var(--dur)) var(--ease-ui);
  }
  .treat .t-chip:hover {
    background: rgba(255, 255, 255, .94);
    box-shadow:
      0 0 0 2px var(--color-light-b),
      0 12px 28px rgb(27 44 52 / calc(.14 * var(--shadow-k)));
  }
  .treat .t-chip b, .treat .t-list b {
    display: block;
    margin-bottom: 2px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: calc(var(--card-title) * 1px);
    color: var(--color-ink);
  }
  /* На узком десктопе плашки сужаются вместе со схемой, поэтому заголовок уменьшается до 16px */
  .treat .t-chip b {
    font-size: clamp(16px, calc(var(--card-title) * 1.5vw / 21), calc(var(--card-title) * 1px));
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .treat .side-l { left: 0; }
  .treat .side-r { right: 0; }

  .treat .scheme-mobile { display: none; }

  @media (max-width: 900px) {
    .treat .scheme { display: none; }
    .treat .scheme-mobile { display: block; padding: 20px var(--pad-x) 0; }
    .treat .scheme-mobile > svg { display: block; width: min(320px, 78%); height: auto; margin: 0 auto; overflow: visible; }
    .treat .t-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 24px 0 0;
      padding: 0;
      list-style: none;
    }
    /* Номер над заголовком, чтобы заголовок занимал всю ширину карточки */
    .treat .t-list a {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: 14px;
      border-radius: calc(16px * var(--round-k));
      background: rgba(255, 255, 255, .78);
      font-size: 14px;
      line-height: 1.35;
      color: var(--color-ink-2);
      text-decoration: none;
      transition: background-color calc(.2s * var(--dur)) var(--ease-ui), box-shadow calc(.2s * var(--dur)) var(--ease-ui);
    }
    .treat .t-list a:active { background: #FFFFFF; box-shadow: 0 0 0 2px var(--color-light-b); }
    .treat .t-list b { font-size: min(16px, calc(var(--card-title) * 16px / 18)); overflow-wrap: break-word; hyphens: auto; }
    .treat .t-list .num {
      flex: none;
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      margin-bottom: 10px;
      border-radius: 50%;
      background: var(--color-ink);
      box-shadow: 0 0 0 2px var(--color-light-b);
      font-family: var(--font-display);
      font-weight: var(--display-weight);
      font-size: 13px;
      color: var(--color-mist);
    }
    .treat[data-aud='adult'] .t-list .aud-child,
    .treat[data-aud='child'] .t-list .aud-adult { display: none; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-treat]');
  section?.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((button) => {
    button.addEventListener('click', () => {
      const aud = button.dataset.set ?? 'adult';
      section.dataset.aud = aud;
      section.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.set === aud));
      });
    });
  });
</script>

---
import SectionLabel from './SectionLabel.astro';

const steps = [
  { title: 'Осмотр', text: 'Врач осматривает зубы и при необходимости делает прицельный снимок.' },
  { title: 'План лечения', text: 'Врач объясняет, что нужно лечить и в какой последовательности.' },
  { title: 'Согласование стоимости', text: 'Стоимость согласуется до начала лечения и указывается в договоре.' },
];
---

<section id="visit" class="bg-mint px-gutter py-section">
  <div class="grid gap-x-gutter gap-y-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <SectionLabel code="12" label="Стоимость" />
      <h2 class="mt-5 max-w-[13ch] text-title font-bold tracking-[-0.025em]">Цена — до начала лечения</h2>
      <p class="mt-5 max-w-[44ch] text-[17px] leading-relaxed">
        Лечение начинается после того, как вы узнали стоимость и согласились с ней.
      </p>
      <p class="mt-8 max-w-[46ch] border-l-2 border-ink pl-4 text-sm text-ink/75">
        Демо-версия: прайс-лист клиники не опубликован в открытых источниках, поэтому цены здесь не указаны.
      </p>
    </div>

    <ol class="border-t-2 border-ink lg:col-span-7" data-reveal>
      {steps.map((step, i) => (
        <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-5 border-b border-ink/20 py-7 sm:gap-x-8 lg:py-9">
          <span class="font-mono text-[clamp(2.75rem,5vw,4.5rem)] font-semibold leading-[0.85] text-pine">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="text-xl font-semibold sm:text-2xl">{step.title}</h3>
            <p class="mt-2 max-w-[48ch] text-ink/75">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

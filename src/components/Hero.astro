---
import { Image } from 'astro:assets';
import photo from '../assets/photos/reception-logo.png';
import { clinic } from '../data/clinic';
---

<section id="top" class="grid lg:min-h-[min(calc(100svh-72px),56rem)] lg:grid-cols-12">
  <div class="on-dark flex flex-col bg-pine px-gutter pt-12 pb-10 text-white lg:col-span-7 lg:pt-16">
    <p class="font-mono text-xs uppercase tracking-[0.14em] text-mint sm:text-[13px]">
      Стоматология · Казань · Салават Купере
    </p>

    <h1 class="mt-6 max-w-[13ch] text-display font-bold tracking-[-0.035em]">
      Лечим зубы <span class="text-amber">взрослым и&nbsp;детям</span>
    </h1>

    <p class="mt-6 max-w-[46ch] text-[17px] leading-relaxed text-white/80 lg:text-lg">
      Хирургия и имплантация, протезирование, исправление прикуса, детский приём. Стоимость лечения согласуется до&nbsp;его&nbsp;начала.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#booking" class="btn btn-amber">
        Записаться на приём
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a href={clinic.phoneHref} class="btn border border-white/35 font-mono font-normal text-white hover:border-white">
        {clinic.phoneDisplay}
      </a>
    </div>

    <div class="mt-12 max-w-xl lg:mt-auto lg:pt-14">
      <div class="grid grid-cols-2 border-t border-white/20">
        {clinic.ratings.map((r, i) => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener"
            class:list={['group pt-5', i === 1 && 'border-l border-white/20 pl-5']}
          >
            <span class="block font-mono text-4xl font-semibold leading-none text-amber lg:text-5xl">{r.score}</span>
            <span class="mt-2 block text-sm text-white/85 group-hover:underline">{r.source} · {r.count}</span>
          </a>
        ))}
      </div>
      <p class="mt-4 font-mono text-[11px] text-white/55">Оценки из открытых карточек клиники, {clinic.ratingsDate}</p>
    </div>
  </div>

  <div class="relative min-h-[82vw] sm:min-h-[460px] lg:col-span-5 lg:min-h-0">
    <Image
      src={photo}
      alt="Вывеска Дентики и зона ожидания у ресепшена"
      widths={[480, 720, 854]}
      sizes="(min-width: 1024px) 42vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-[50%_24%]"
    />
    <span class="photo-cap">Зона ожидания у ресепшена</span>
  </div>
</section>

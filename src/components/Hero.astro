---
import { Image } from 'astro:assets';
import { audienceText, clinic, direction } from '../data/clinic';
import tooth from '../assets/hero-tooth.png';

// Плашки по бокам постамента: одно направление только для взрослых, одно для всех
const chips = { l: direction('implant'), r: direction('orthodontics') };
---

<section id="top" class="hero" data-hero>
  <div class="sticky field">
    <div class="copy">
      <h1>Стоматология для взрослых и&nbsp;детей</h1>
      <p class="lead">Хирургия, ортодонтия, ортопедия и имплантация в одной клинике в Салават Купере.</p>
      <div class="acts">
        <a class="btn btn-dark" href="#booking">Записаться на приём</a>
        <a class="tel" href={clinic.phoneHref}>{clinic.phoneDisplay}</a>
      </div>
      <ul class="rates rates-inline">
        {clinic.ratings.map((r) => (
          <li><a href={r.href} target="_blank" rel="noopener"><b>{r.score}</b>{r.source}, {r.count}</a></li>
        ))}
      </ul>
    </div>

    <div class="stage-anchor">
      <div class="stage">
        <div class="ped-side"></div>
        <div class="ped-top"><i class="sweep"></i></div>
        <div class="ped-ring"></div>
        <div class="object">
          <Image src={tooth} alt="" widths={[210, 420, 630]} sizes="210px" loading="eager" fetchpriority="high" />
        </div>
        <a class="chip chip-l" href="#booking" data-book={chips.l.id}><b>{chips.l.label}</b>{audienceText(chips.l.aud)}</a>
        <a class="chip chip-r" href="#booking" data-book={chips.r.id}><b>{chips.r.label}</b>{audienceText(chips.r.aud)}</a>
      </div>
    </div>

    <div class="chips-m">
      <a class="chip chip-m chip-m-l" href="#booking" data-book={chips.l.id}><b>{chips.l.label}</b>{audienceText(chips.l.aud)}</a>
      <a class="chip chip-m chip-m-r" href="#booking" data-book={chips.r.id}><b>{chips.r.label}</b>{audienceText(chips.r.aud)}</a>
    </div>

    <ul class="rates rates-corner">
      {clinic.ratings.map((r) => (
        <li><a href={r.href} target="_blank" rel="noopener"><b>{r.score}</b>{r.source}, {r.count}</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Прогресс прокрутки разложен на три дорожки: --pt текст, --ps постамент и плашки, --pl блик света */
  .hero {
    --pt: 0;
    --ps: 0;
    --pl: 0;
    --s: 1;
    --lift: 0px;
    position: relative;
    height: calc(100svh + var(--pin) * 1svh);
  }
  /* Фон на самом экране, а не на всей зоне закрепления: так пол под постаментом совпадает с макетом */
  .sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
  }

  .copy {
    position: absolute;
    left: 0;
    right: 0;
    top: 132px;
    z-index: 3;
    padding: 0 var(--pad-x);
    text-align: center;
    opacity: calc(1 - min(1, var(--pt) * 1.8));
    transform: translateY(calc(var(--pt) * -60px));
  }
  h1 {
    font-size: clamp(calc(var(--h1) * 36px / 60), calc(var(--h1) * 4.2vw / 60), calc(var(--h1) * 1px));
    line-height: var(--h1-lh);
    letter-spacing: calc(var(--h1-track) * 1em);
    text-wrap: balance;
  }
  .lead {
    max-width: 560px;
    margin: 18px auto 0;
    font-size: clamp(calc(var(--lead) * 18px / 21), calc(var(--lead) * 1.5vw / 21), calc(var(--lead) * 1px));
    line-height: var(--lead-lh);
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .acts {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 28px;
  }
  .tel {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--color-ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  /* Постамент и предмет: размеры из утверждённого макета 640 на 430 */
  .stage-anchor {
    position: absolute;
    left: 50%;
    bottom: var(--lift);
    width: 640px;
    height: 430px;
    transform-origin: 50% 100%;
    transform: translateX(-50%) scale(var(--s));
  }
  .stage {
    position: absolute;
    inset: 0;
    transform-origin: 50% 72%;
    transform:
      translateY(calc(var(--ps) * -1 * var(--rise, 150px) * var(--rise-k)))
      scale(calc(1 + var(--ps) * var(--zoom, .22) * var(--zoom-k)));
  }
  /* Зуб стоит кончиками корней на центре верхней грани постамента (y около 318) */
  .object {
    position: absolute;
    left: 215px;
    top: -17px;
    z-index: 2;
    width: 210px;
  }
  .object :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 calc(18px + var(--ps) * 14px) calc(24px + var(--ps) * 16px) rgb(27 44 52 / calc(.22 * var(--shadow-k))));
  }
  .object::after {
    content: '';
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: -4px;
    z-index: -1;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(27 44 52 / calc(.28 * var(--shadow-k))), transparent);
  }
  .ped-top {
    position: absolute;
    left: 40px;
    top: 250px;
    z-index: 1;
    width: 560px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(180deg, #FFFFFF 0%, #E3EBEE 100%);
    overflow: hidden;
  }
  .sweep {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 35%, rgb(from var(--color-light-b) r g b / .95) 50%, transparent 65%);
    opacity: min(1, calc(var(--pl) * 3));
    transform: translateX(calc(-100% + var(--pl) * 200%));
  }
  .ped-side {
    position: absolute;
    left: 40px;
    top: 310px;
    width: 560px;
    height: 100px;
    border-radius: 0 0 50% 50% / 0 0 60px 60px;
    background: linear-gradient(180deg, #D3DFE4, #B9C9D0);
  }
  .ped-ring {
    position: absolute;
    left: 50px;
    top: 296px;
    z-index: 1;
    width: 540px;
    height: 100px;
    border: 3px solid var(--color-light-b);
    border-radius: 50%;
    box-shadow: 0 6px calc((22px + var(--ps) * 26px) * var(--glow))
      rgb(from var(--color-light) r g b / calc((.75 + var(--ps) * .25) * min(1, var(--glow))));
  }

  .chip {
    position: absolute;
    z-index: 4;
    margin: 0;
    padding: 14px 18px;
    border-radius: calc(16px * var(--round-k));
    background: rgba(255, 255, 255, .72);
    box-shadow: 0 10px 24px rgb(27 44 52 / calc(.10 * var(--shadow-k)));
    font-size: calc(var(--chip-note) * 1px);
    line-height: 1.35;
    color: var(--color-ink-2);
    white-space: nowrap;
    opacity: calc(1 - min(1, max(0, var(--ps) - .45) * 2.4));
  }
  .chip b {
    display: block;
    margin-bottom: 2px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: calc(var(--chip-title) * 1px);
    color: var(--color-ink);
  }
  /* Плашка ведёт к записи с выбранным направлением */
  a.chip {
    text-decoration: none;
    transition:
      background-color calc(.2s * var(--dur)) var(--ease-ui),
      box-shadow calc(.2s * var(--dur)) var(--ease-ui);
  }
  a.chip:hover {
    background: rgba(255, 255, 255, .94);
    box-shadow:
      0 0 0 2px var(--color-light-b),
      0 12px 28px rgb(27 44 52 / calc(.14 * var(--shadow-k)));
  }
  /* Растворившиеся при прокрутке плашки не должны ловить нажатия */
  .hero[data-chips-gone] .stage .chip,
  .hero[data-chips-m-gone] .chip-m { pointer-events: none; }
  .chip-l { left: -140px; top: 130px; transform: translate(calc(var(--ps) * -80px), calc(var(--ps) * -30px)); }
  .chip-r { left: 600px; top: 90px; transform: translate(calc(var(--ps) * 80px), calc(var(--ps) * -30px)); }
  .chips-m { display: none; }

  .rates { display: flex; gap: 40px; list-style: none; margin: 0; padding: 0; }
  .rates a { display: block; font-size: 14px; color: var(--color-ink-2); text-decoration: none; }
  .rates a:hover { color: var(--color-ink); }
  .rates b {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 28px;
    line-height: 1.2;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .rates-corner {
    position: absolute;
    left: var(--pad-x);
    bottom: 56px;
    opacity: calc(1 - min(1, var(--pt) * 2.2));
  }
  .rates-inline { display: none; justify-content: center; margin-top: 22px; gap: 32px; }
  .rates-inline b { font-size: 22px; }

  @media (max-height: 820px) {
    .hero { --s: .84; }
    .copy { top: 116px; }
  }
  @media (max-height: 720px) {
    .hero { --s: .7; }
  }
  @media (max-width: 1279px) {
    .rates-corner { display: none; }
    .rates-inline { display: flex; }
  }
  /* На планшете и телефоне плашки не масштабируются вместе с постаментом:
     левая стоит у верхней части зуба, правая ниже, у края постамента.
     Размеры текста уменьшены пропорционально десктопным: 20 и 16 px превращаются в 14 и 12 px */
  @media (max-width: 1000px) {
    .stage .chip { display: none; }
    .chips-m {
      position: absolute;
      inset: 0;
      z-index: 4;
      display: block;
      pointer-events: none;
      opacity: calc(1 - min(1, var(--ps) * 2.4));
    }
    .chip-m {
      max-width: min(36%, 230px);
      padding: 10px 14px;
      border-radius: calc(14px * var(--round-k));
      background: rgba(255, 255, 255, .82);
      font-size: calc(var(--chip-note) * 12px / 16);
      white-space: normal;
      opacity: 1;
      pointer-events: auto;
    }
    .chip-m b { font-size: calc(var(--chip-title) * 14px / 20); line-height: 1.25; }
    .chip-m-l { left: var(--pad-x); bottom: calc(var(--lift) + 330px * var(--s)); }
    .chip-m-r { right: var(--pad-x); bottom: calc(var(--lift) + 100px * var(--s)); }
  }
  @media (max-width: 720px) {
    .hero { --s: .6; --lift: 56px; --rise: 380px; --zoom: .12; height: calc(100svh + var(--pin) * .7svh); }
    .copy { top: 92px; }
    .lead { margin-top: 14px; }
    .acts { margin-top: 22px; }
    /* Размеры плашек из панели твиков подобраны на десктопе; на телефоне крупнее 14 и 12 px плашки закрывают коронку зуба */
    .chip-m { font-size: min(calc(var(--chip-note) * 12px / 16), 12px); }
    .chip-m b { font-size: min(calc(var(--chip-title) * 14px / 20), 14px); }
  }
  @media (max-width: 720px) and (max-height: 740px) {
    .hero { --s: .36; --lift: 0px; }
    .lead { font-size: 16px; }
    .rates-inline { margin-top: 14px; }
    .rates-inline b { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero { height: 100svh; --pt: 0 !important; --ps: 0 !important; --pl: 0 !important; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const segment = (p: number, from: number, to: number) => smooth(clamp01((p - from) / (to - from)));

  if (hero) {
    // Тип анимации задаётся переменной --hero-anim в global.css (ease-out, staged, smooth, linear, off)
    let mode = 'ease-out';
    const readMode = () => {
      mode = getComputedStyle(document.documentElement).getPropertyValue('--hero-anim').trim() || 'ease-out';
    };
    let queued = false;
    const set = (pt: number, ps: number, pl: number) => {
      hero.style.setProperty('--pt', pt.toFixed(4));
      hero.style.setProperty('--ps', ps.toFixed(4));
      hero.style.setProperty('--pl', pl.toFixed(4));
      // Пороги совпадают с CSS-прозрачностью плашек: на десктопе они гаснут к 0.87, на телефоне к 0.42
      hero.toggleAttribute('data-chips-gone', ps > 0.8);
      hero.toggleAttribute('data-chips-m-gone', ps > 0.35);
    };
    const update = () => {
      queued = false;
      if (reduce.matches || mode === 'off') {
        set(0, 0, 0);
        return;
      }
      const range = hero.offsetHeight - window.innerHeight;
      const p = range > 0 ? clamp01(-hero.getBoundingClientRect().top / range) : 0;
      if (mode === 'staged') {
        // Текст уходит в первые 40%, постамент движется с 20 до 90%, блик пробегает в последние 40%
        set(segment(p, 0, 0.4), segment(p, 0.2, 0.9), segment(p, 0.6, 1));
      } else if (mode === 'smooth') {
        const s = smooth(p);
        set(s, s, s);
      } else if (mode === 'linear') {
        set(p, p, p);
      } else {
        const eased = 1 - (1 - p) * (1 - p);
        set(eased, eased, eased);
      }
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    readMode();
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    window.addEventListener('tweaks:change', () => {
      readMode();
      queue();
    });
    update();
  }
</script>

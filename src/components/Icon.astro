---
interface Props {
  name: 'camera' | 'pin' | 'alert' | 'phone' | 'arrow';
  size?: number;
}

const { name, size = 16 } = Astro.props;

const paths = {
  camera: '<path d="M4 8h3l2-2.5h6L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  alert: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.01"/>',
  phone: '<path d="M6.2 3.8h2.9l1.6 4.3-2.1 1.3a11.5 11.5 0 0 0 6 6l1.3-2.1 4.3 1.6v2.9a1.6 1.6 0 0 1-1.7 1.6C10.5 18.9 5.1 13.5 4.6 5.5a1.6 1.6 0 0 1 1.6-1.7z"/>',
  arrow: '<path d="M5 12h14M13.5 6.5 19 12l-5.5 5.5"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  style="flex:none"
  set:html={paths[name]}
/>

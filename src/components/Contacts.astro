    <div>
      <div class="text-xs text-slate-text font-mono mb-1.5">ТЕЛЕФОН</div>
      <div class="text-[15px] font-mono"><a href="tel:+79102866767" class="no-underline">+7 (910) 286-67-67</a></div>

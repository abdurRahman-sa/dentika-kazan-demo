---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Dentika — стоматология в Казани' } = Astro.props;
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/bitter-700-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ptsans-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plexmono-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="m-0 pb-[44px] max-[480px]:pb-[76px]">
    <slot />
  </body>
</html>
